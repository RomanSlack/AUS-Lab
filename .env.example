# AUS-Lab Environment Configuration
# Copy this file to .env and fill in your API keys

# Mapbox Access Token (Required for terrain loading)
# Get your token at: https://mapbox.com
# 1. Create a free account
# 2. Go to Account -> Access tokens
# 3. Create a new token or use the default public token
MAPBOX_ACCESS_TOKEN=pk.your_mapbox_access_token_here

# Google Gemini API Key (Required for agentic natural language control)
# Get your key at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
